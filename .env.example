# ==============================================================================
# SmartMedChart — Unified Environment Configuration
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PRISMA)
# ------------------------------------------------------------------------------
# SQLite (Default Local Dev):
DATABASE_URL="file:./smartmed.db"

# PostgreSQL / Production Alternative:
# DATABASE_URL="postgresql://smartmed:smartmed123@localhost:5432/smartmedchart"
# DB_USER=smartmed
# DB_PASSWORD=smartmed123
# DB_NAME=smartmedchart
# DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT & HMAC AUDIT)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens and audit trail HMAC signatures (min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h

# ------------------------------------------------------------------------------
# 3. SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. FRONTEND CLIENT
# ------------------------------------------------------------------------------
# Base API URL used by frontend client (defaults to '/api' in production / Vite proxy)
VITE_API_URL=http://localhost:3001/api

# ------------------------------------------------------------------------------
# 5. SUPABASE (OPTIONAL CLOUD PERSISTENCE)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# 6. AI & EXTERNAL INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Gemini API key if using AI assistive clinical documentation
GEMINI_API_KEY=your-gemini-api-key
APP_URL=http://localhost:5173
