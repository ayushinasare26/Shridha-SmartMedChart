generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AdministrationRecord_rows {
  id                 String    @id
  scheduleId         String?
  patientId          String?
  administeredById   String?
  dose               BigInt?
  unit               String?
  route              String?
  notes              String?
  fiveRightsVerified Boolean?
  rightPatient       Boolean?
  rightDrug          Boolean?
  rightDose          Boolean?
  rightRoute         Boolean?
  rightTime          Boolean?
  barcodeScanned     Boolean?
  witnessId          String?
  signedAt           DateTime? @db.Timestamptz(6)
  adminId            String?
  safetyScore        BigInt?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Allergy_rows {
  id              String    @id
  patientId       String?
  allergen        String?
  severity        String?
  reaction        String?
  verifiedAt      DateTime? @db.Timestamptz(6)
  verifiedBy      String?
  crossReactsWith String?
  createdAt       DateTime? @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AuditLog_rows {
  id          String    @id
  userId      String?
  patientId   String?
  action      String?
  resource    String?
  resourceId  String?
  detail      String?
  ipAddress   String?
  workstation String?
  hmacHash    String?
  severity    String?
  createdAt   DateTime? @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model MedicationSchedule_rows {
  id                 String    @id
  prescriptionId     String?
  patientId          String?
  scheduledTime      DateTime? @db.Timestamptz(6)
  status             String?
  administeredById   String?
  administeredAt     String?
  verificationMethod String?
  holdReason         String?
  delayReason        String?
  delayMinutes       String?
  preparedAt         String?
  dispensedFrom      String?
  batchNumber        String?
  createdAt          DateTime? @db.Timestamptz(6)
  updatedAt          DateTime? @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Notification_rows {
  id        String    @id
  userId    String?
  patientId String?
  type      String?
  message   String?
  detail    String?
  isRead    Boolean?
  priority  String?
  createdAt DateTime? @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Patient_rows {
  id                       String    @id
  mrn                      String?
  name                     String?
  dob                      DateTime? @db.Timestamptz(6)
  sex                      String?
  weight                   Float?
  weightUnit               String?
  wardId                   String?
  bed                      String?
  attendingId              String?
  admissionDiagnosis       String?
  npoStatus                Boolean?
  codeStatus               String?
  isolationStatus          Boolean?
  status                   String?
  eGFR                     BigInt?
  creatinine               Float?
  bilirubin                Float?
  platelets                BigInt?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  createdAt                DateTime? @db.Timestamptz(6)
  updatedAt                DateTime? @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Prescription_rows {
  id                 String    @id
  patientId          String?
  prescriberId       String?
  medicationName     String?
  genericName        String?
  medicationClass    String?
  dose               Float?
  unit               String?
  route              String?
  frequency          String?
  startDate          DateTime? @db.Timestamptz(6)
  stopDate           String?
  status             String?
  indication         String?
  isStatOrder        Boolean?
  isContinuous       Boolean?
  infusionRate       String?
  pharmacyVerified   Boolean?
  pharmacyVerifiedAt String?
  pharmacyVerifiedBy String?
  requiresCoSign     Boolean?
  coSignedById       String?
  coSignedAt         String?
  overrideReason     String?
  formularyRef       String?
  rxNumber           String?
  createdAt          DateTime? @db.Timestamptz(6)
  updatedAt          DateTime? @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model RefreshToken_rows {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SafetyAlert_rows {
  id             String    @id
  patientId      String?
  prescriptionId String?
  alertType      String?
  severity       String?
  message        String?
  detail         String?
  isOverridden   Boolean?
  isResolved     Boolean?
  overrideReason String?
  overrideById   String?
  overriddenAt   String?
  resolvedAt     String?
  createdAt      DateTime? @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User_rows {
  id            String    @id
  email         String?
  name          String?
  role          String?
  passwordHash  String?
  staffId       String?
  ward          String?
  department    String?
  title         String?
  specialty     String?
  licenseNumber String?
  shiftType     String?
  onDuty        Boolean?
  avatarUrl     String?
  isActive      Boolean?
  createdAt     DateTime? @db.Timestamptz(6)
  updatedAt     DateTime? @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Ward_rows {
  id        String    @id
  name      String?
  unit      String?
  capacity  BigInt?
  occupancy BigInt?
  location  String?
  createdAt DateTime? @db.Timestamptz(6)
  updatedAt DateTime? @db.Timestamptz(6)
}
